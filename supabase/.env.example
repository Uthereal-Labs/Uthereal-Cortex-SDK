# Server-only settings. Copy assistant/base values from Cortex Share’s integration instructions.
CORTEX_API_BASE_URL=https://agent.uthereal.ai/api/functions/v1/api-server-proxy
CORTEX_ASSISTANT_ID=replace-with-your-assistant-id
CORTEX_SHARED_API_KEY=install-separately-in-server-secrets
APP_ORIGIN=http://localhost:5173
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase Functions.
