{
  "name": "@uthereal-sdk/cortex",
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "pnpm build:package && pnpm build:demo",
    "test": "deno test --allow-read=examples --config deno.json tests",
    "check:edge": "deno check --config supabase/functions/cortex/deno.json supabase/functions/cortex/index.ts",
    "generate:types": "node scripts/generate-types.mjs",
    "verify:types": "node scripts/generate-types.mjs --check",
    "lint": "deno lint sdk src tests examples && deno fmt --check sdk src tests examples scripts",
    "verify": "pnpm verify:types && pnpm lint && pnpm test && pnpm test:node && pnpm check:edge && pnpm build",
    "test:node": "tsc -p tsconfig.node.json && node tests/node-smoke.mjs",
    "build:package": "node scripts/build-package.mjs",
    "build:demo": "tsc --noEmit && vite build --outDir .cache/demo",
    "prepack": "pnpm build:package",
    "test:package": "node scripts/test-package.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@supabase/supabase-js": "2.104.0",
    "@tanstack/react-query": "5.100.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "openapi-typescript": "7.13.0",
    "pdfjs-dist": "4.4.168",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-pdf": "9.1.1",
    "typescript": "5.9.3",
    "vite": "8.0.10"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.22.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Uthereal-Labs/Uthereal-Cortex-SDK.git"
  },
  "description": "Typed Cortex integration: streaming answers, retrieval, citations and authenticated PDF evidence.",
  "main": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "peerDependencies": {
    "@supabase/supabase-js": "^2.104.0",
    "@tanstack/react-query": "^5.100.6",
    "pdfjs-dist": "4.4.168",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-pdf": "9.1.1"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-pdf": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "browser": null,
      "import": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./adapters/supabase-server": {
      "types": "./dist/adapters/supabase-server.d.ts",
      "browser": null,
      "import": "./dist/adapters/supabase-server.js"
    },
    "./adapters/supabase-browser": {
      "types": "./dist/adapters/supabase-browser.d.ts",
      "import": "./dist/adapters/supabase-browser.js"
    },
    "./styles.css": "./dist/react/styles.css",
    "./openapi.json": "./openapi.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/react/PdfEvidence.js"
  ],
  "files": [
    "dist",
    "openapi.json",
    "README.md",
    "INTEGRATING.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/Uthereal-Labs/Uthereal-Cortex-SDK#readme",
  "bugs": {
    "url": "https://github.com/Uthereal-Labs/Uthereal-Cortex-SDK/issues"
  }
}
